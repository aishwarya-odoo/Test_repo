<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_tally" model="ir.module.category">
        <field name="name">Tally Integration</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_tally" model="res.groups.privilege">
        <field name="name">Tally Integration</field>
        <field name="category_id" ref="module_category_tally" />
    </record>

    <record id="group_tally_user" model="res.groups">
        <field name="name">Tally Integration User</field>
        <field name="privilege_id" ref="privilege_tally" />
        <field name="comment">Can view synchronization status, logs and retry failed records.</field>
    </record>

    <record id="group_tally_manager" model="res.groups">
        <field name="name">Tally Integration Manager</field>
        <field name="privilege_id" ref="privilege_tally" />
        <field name="implied_ids" eval="[(4, ref('group_tally_user'))]" />
        <field name="comment">Can configure RabbitMQ/Tally connection settings and manage mappings.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
</odoo>
