<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_form_tally" model="ir.ui.view">
        <field name="name">product.template.form.tally</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="button_tally_sync" type="object" string="Sync to Tally" class="oe_highlight" />
                    <field name="tally_sync_state" widget="statusbar" statusbar_visible="not_synced,pending,synced" />
                </header>
            </xpath>
        </field>
    </record>

    <record id="action_tally_sync_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
