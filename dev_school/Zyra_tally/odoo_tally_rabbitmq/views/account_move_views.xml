<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_tally" model="ir.ui.view">
        <field name="name">account.move.form.tally</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="tally_sync_state" widget="statusbar" statusbar_visible="not_synced,pending,synced"
                       invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')" />
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="button_tally_sync" type="object" string="Sync to Tally"
                        invisible="state != 'posted' or move_type not in ('out_invoice','out_refund','in_invoice','in_refund')" />
            </xpath>
        </field>
    </record>

    <record id="action_tally_sync_invoices" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]</field>
    </record>
</odoo>
