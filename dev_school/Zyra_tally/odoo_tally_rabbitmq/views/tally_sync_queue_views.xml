<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_tally_sync_queue_list" model="ir.ui.view">
        <field name="name">tally.sync.queue.list</field>
        <field name="model">tally.sync.queue</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('failed','dead_letter')" decoration-success="state=='success'" decoration-muted="state=='cancelled'">
                <field name="name" />
                <field name="direction" />
                <field name="state" />
                <field name="retry_count" />
                <field name="scheduled_at" />
                <field name="processed_at" />
                <field name="error_message" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_tally_sync_queue_form" model="ir.ui.view">
        <field name="name">tally.sync.queue.form</field>
        <field name="model">tally.sync.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            invisible="state not in ('failed','dead_letter','cancelled')" class="oe_highlight" />
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('success','cancelled')" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_type" />
                            <field name="direction" />
                            <field name="odoo_model" />
                            <field name="odoo_record_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group>
                            <field name="message_id" />
                            <field name="idempotency_key" />
                            <field name="retry_count" />
                            <field name="max_retries" />
                            <field name="scheduled_at" />
                            <field name="processed_at" />
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" />
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1" widget="ace" options="{'mode': 'json'}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tally_sync_queue_search" model="ir.ui.view">
        <field name="name">tally.sync.queue.search</field>
        <field name="model">tally.sync.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_type" />
                <field name="odoo_model" />
                <filter name="pending" string="Pending" domain="[('state','=','pending')]" />
                <filter name="failed" string="Failed" domain="[('state','in',('failed','dead_letter'))]" />
                <filter name="success" string="Success" domain="[('state','=','success')]" />
                <group>
                    <filter name="g_state" string="State" context="{'group_by':'state'}" />
                    <filter name="g_event" string="Event Type" context="{'group_by':'event_type'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_tally_sync_queue" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">tally.sync.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tally_dead_letter" model="ir.actions.act_window">
        <field name="name">Failed Synchronizations</field>
        <field name="res_model">tally.sync.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('failed', 'dead_letter'))]</field>
    </record>
</odoo>
